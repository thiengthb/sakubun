.turbo/
.cache/
coverage/
*.tsbuildinfo
# next-env.d.ts is GENERATED by Next on every dev/build, and Next 16 writes a DIFFERENT import for
# each: `next build` -> ./.next/types/routes.d.ts, `next dev` -> ./.next/dev/types/routes.d.ts. Tracked,
# it therefore flip-flops every time you switch between them, which shows up as a dirty tree and fails
# the stop gate's gen-clean check for a file no human ever edits. Ignoring it is also what
# create-next-app does by default, and `npm run typecheck` passes without it (verified 2026-08-05).
next-env.d.ts
__pycache__/
.venv/
target/

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── sakubun ──────────────────────────────────────────────────────────────────
# Prisma 7 sinh client vào đây (schema.prisma → output). Artifact của `npm run gen`.
lib/generated/
# SQLite dev DB: DỮ LIỆU người học, không phải code. Không bao giờ commit.
prisma/dev.db
prisma/dev.db-journal
prisma/*.db-shm
prisma/*.db-wal
# Playwright
test-results/
playwright-report/
.playwright/
# Throwaway e2e database (e2e/fixtures.ts E2E_DB_FILE) — rebuilt from the migrations on every run.
e2e-test.db
e2e-test.db-*
# Hand-taken safety copies of the LIVE database (`docker cp sakubun:/data/sakubun.db`) before a
# migration. Real study data and multi-MB — must never land in git, and the name is deliberate so
# `backup-` is the one prefix you reach for.
backup-*.db
