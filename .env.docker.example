# Copy to .env.docker (gitignored) and fill in before the first `docker compose up -d --build`.
# ĐÂY LÀ FILE VÍ DỤ — không bao giờ đặt giá trị thật vào đây.
#
# CỐ Ý KHÔNG có DATABASE_URL: image đã ghim file:/data/sakubun.db, đúng chỗ volume được mount.
# Đặt lại biến đó ở đây sẽ trỏ app sang một DB khác và bạn mất toàn bộ lịch sử học.

# ── Bắt buộc ─────────────────────────────────────────────────────────────────
# Sinh secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL công khai mà trình duyệt dùng để mở app. Sai giá trị này thì cookie phiên không được nhận.
BETTER_AUTH_URL="http://localhost:3789"
# Origin phụ, phân tách bằng dấu phẩy (ví dụ khi chạy thêm qua tunnel/reverse proxy).
BETTER_AUTH_TRUSTED_ORIGINS=""

# ── Bắt buộc: đăng nhập Google ───────────────────────────────────────────────
# Google là cách đăng nhập DUY NHẤT. Thiếu một trong ba biến dưới đây thì không ai vào được.
# OAuth client (loại Web) tạo ở Google Cloud Console; redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Gmail duy nhất được phép đăng nhập. Để trống = chặn tất cả.
ALLOWED_EMAIL=""

# ── Tuỳ chọn: TTS ────────────────────────────────────────────────────────────
# VOICEVOX_URL do docker-compose.yml đặt sẵn (http://voicevox:50021) — không cần khai lại ở đây.
VOICEVOX_SPEAKER="2"
