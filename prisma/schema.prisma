generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Item {
  id            String    @id @default(cuid())
  kind          String
  expression    String
  reading       String?
  hanviet       String?
  meaningVi     String
  level         String    @default("N5")
  notes         String?
  tags          String?
  source        String    @default("MANUAL")

  captureReason String?
  suspended     Boolean   @default(false)

  starred       Boolean   @default(false)

  enrichment    String?
  enrichedAt    DateTime?

  createdAt DateTime @default(now())

  srs     SrsState?
  reviews ReviewLog[]
  groups  GroupMember[]

  challenge             Float?
  challengeObservations Int    @default(0)

  @@unique([kind, expression])

  @@index([kind])
}

model SrsState {
  id            String    @id @default(cuid())
  itemId        String    @unique
  item          Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  scheduledDays Int       @default(0)
  learningSteps Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0)
  lastReview    DateTime?

  @@index([due])

  @@index([state])
}

model ReviewLog {
  id          String    @id @default(cuid())

  itemId      String?
  item        Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  rating      Int
  state       Int
  role        String    @default("TARGET")
  errorTags   String?

  errorDetail String?
  due         DateTime
  stability   Float
  difficulty  Float
  reviewedAt  DateTime  @default(now())
  sentenceId  String?
  sentence    Sentence? @relation(fields: [sentenceId], references: [id], onDelete: SetNull)

  @@index([reviewedAt])
  @@index([itemId, reviewedAt])

  @@index([rating, reviewedAt])
}

model Sentence {
  id            String    @id @default(cuid())
  direction     String
  context       String?
  exerciseType  String    @default("TRANSLATION")
  sourceText    String

  sourceRuby    String?
  userAnswer    String
  suggested     String?

  suggestedRuby String?
  feedback      String?
  score         Int?

  stagedItems   String?

  extraPatterns String?

  status        String    @default("PENDING")

  starred       Boolean   @default(false)
  createdAt     DateTime  @default(now())

  answeredAt    DateTime?

  reviews ReviewLog[]

  @@index([createdAt])
}

model LearnerNote {
  id String @id @default(cuid())

  text String

  evidence String

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model LearnerAbility {

  id String @id @default("singleton")

  abilityReceptive       Float @default(1000)
  receptiveObservations  Int   @default(0)

  abilityProductive      Float @default(1000)
  productiveObservations Int   @default(0)

  abilityRegister        Float @default(1000)
  registerObservations   Int   @default(0)

  updatedAt DateTime @updatedAt
}

model CalibrationProposal {
  id String @id @default(cuid())

  target    String

  direction String

  fromValue String
  toValue   String

  axis         String
  measured     Float
  ability      Float
  observations Int

  reason String

  sentenceId String?

  createdAt DateTime @default(now())

  verdict String?

  @@index([createdAt])
}

model Settings {
  id        Int      @id @default(autoincrement())
  data      String
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  mcpKeys       McpKey[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model McpKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  // 'full' | 'planner' — see lib/auth/mcp-key.ts
  scope      String    @default("full")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("mcp_key")
}

model McpToolCall {
  name          String   @id
  calls         Int      @default(0)
  errors        Int      @default(0)
  lastMs        Int?
  lastError     String?
  lastErrorAt   DateTime?
  firstCalledAt DateTime @default(now())
  lastCalledAt  DateTime @default(now())

  @@map("mcp_tool_call")
}

model Group {
  id        String   @id @default(cuid())
  name      String

  kind      String   @default("mixed")
  color     String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GroupMember[]
}

model GroupMember {
  groupId String
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  itemId  String
  item    Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([groupId, itemId])
  @@index([itemId])
}
