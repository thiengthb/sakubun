  "scripts": {
    "dev": "next dev -p 3789",
    "build": "next build",
    "start": "next start -p 3789",
    "gen": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:file": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "verify": "npm run gen && npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write"
  },
