# Copy to .env (gitignored). `node tooling/init.mjs` does this for you.
# Đây là FILE VÍ DỤ — không bao giờ đặt giá trị thật vào đây.

# ── Bắt buộc ─────────────────────────────────────────────────────────────────
# SQLite. Mặc định của prisma.config.ts là file:./prisma/dev.db nếu để trống.
DATABASE_URL="file:./prisma/dev.db"

# better-auth. Sinh secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3789"
# Origin phụ, phân tách bằng dấu phẩy (ví dụ khi chạy qua tunnel).
BETTER_AUTH_TRUSTED_ORIGINS=""

# ── Bắt buộc: đăng nhập Google ───────────────────────────────────────────────
# Google là cách đăng nhập DUY NHẤT. Thiếu một trong ba biến dưới đây thì không ai vào được.
# OAuth client (loại Web) tạo ở Google Cloud Console; redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Gmail duy nhất được phép đăng nhập. Để trống = chặn tất cả.
ALLOWED_EMAIL=""

# ── Tuỳ chọn: TTS (VOICEVOX) ─────────────────────────────────────────────────
VOICEVOX_URL="http://voicevox:50021"
VOICEVOX_SPEAKER="2"
# Câu đã đọc được lưu thành file WAV (K6a). Mặc định: thư mục tts-cache cạnh file SQLite khi
# DATABASE_URL là đường dẫn tuyệt đối (/data trên NUC); dev với ./dev.db thì không cache.
# TTS_CACHE_DIR="/data/tts-cache"
# TTS_CACHE_MAX_MB="300"
