# Copy to .env (gitignored). `node tooling/init.mjs` does this for you.
# Đây là FILE VÍ DỤ — không bao giờ đặt giá trị thật vào đây.

# ── Bắt buộc ─────────────────────────────────────────────────────────────────
# SQLite. Mặc định của prisma.config.ts là file:./prisma/dev.db nếu để trống.
DATABASE_URL="file:./prisma/dev.db"

# better-auth. Sinh secret: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3789"
# Origin phụ, phân tách bằng dấu phẩy (ví dụ khi chạy qua tunnel).
BETTER_AUTH_TRUSTED_ORIGINS=""

# ── Tuỳ chọn: Google sign-in ─────────────────────────────────────────────────
# Provider chỉ bật khi có CẢ HAI biến. Thiếu một cái → bỏ hẳn provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Tuỳ chọn: email (verify, reset password, thông báo admin) ─────────────────
# Thiếu bất kỳ biến nào trong HOST/USER/PASS → transport = null, app không gửi mail.
SMTP_HOST=""
SMTP_USER=""
SMTP_PASS=""
SMTP_PORT="587"
SMTP_FROM=""
ADMIN_EMAIL=""

# ── Tuỳ chọn: TTS (VOICEVOX) ─────────────────────────────────────────────────
VOICEVOX_URL="http://voicevox:50021"
VOICEVOX_SPEAKER="2"
